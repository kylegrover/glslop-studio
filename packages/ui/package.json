{
  "name": "@glslop/ui",
  "version": "0.1.0",
  "description": "glslop's shared Svelte 5 components (ISF code editor, video export) and its brutalist stylesheet.",
  "keywords": [
    "isf",
    "glsl",
    "shader",
    "svelte",
    "glslop"
  ],
  "license": "CC0-1.0",
  "type": "module",
  "author": "Kyle Grover",
  "homepage": "https://glslop.com",
  "bugs": "https://github.com/kylegrover/glslop-studio/issues",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylegrover/glslop-studio.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*.svelte": {
      "types": "./src/*.svelte",
      "svelte": "./src/*.svelte",
      "default": "./src/*.svelte"
    },
    "./*.css": "./src/*.css"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@glslop/core": "^0.1.0",
    "svelte": "^5.40.0"
  }
}
