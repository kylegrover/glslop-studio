{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": [
      "svelte",
      "vite/client"
    ],
    "customConditions": [
      "glslop-source"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.svelte"
  ]
}
