{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Every studio window gets the same (deliberately broad) permissions. Mods are trusted code; credentials stay in Rust (see src/auth.rs).",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "dialog:default",
    "process:allow-restart",
    "updater:default"
  ]
}
