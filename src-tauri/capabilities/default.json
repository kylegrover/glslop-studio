{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: every app command except the two that belong to the publish confirmation window, plus the plugins it uses. Deliberately broad: mods are trusted code and run here. Credentials stay in Rust (see src/auth.rs).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "dialog:default",
    "process:allow-restart",
    "updater:default",
    "allow-boot-info",
    "allow-relaunch",
    "allow-quit",
    "allow-confirm-native",
    "allow-bridge-ready",
    "allow-bridge-reply",
    "allow-probe-start",
    "allow-probe-stop",
    "allow-auth-sign-in",
    "allow-auth-status",
    "allow-auth-sign-out",
    "allow-glslop-api",
    "allow-glslop-publish",
    "allow-fs-read-text",
    "allow-fs-write-text",
    "allow-fs-write-base64",
    "allow-fs-write-bytes",
    "allow-fs-list",
    "allow-fs-mkdir",
    "allow-fs-remove",
    "allow-fs-exists",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized"
  ]
}
