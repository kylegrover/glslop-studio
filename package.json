{
  "name": "glslop-studio",
  "version": "0.1.0-beta.8",
  "private": true,
  "type": "module",
  "description": "Desktop studio for browsing and making glslop ISF shaders. Moddable; drivable by your own agent.",
  "license": "CC0-1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
